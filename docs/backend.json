
{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Represents a heritage node in the wiki, which can be a State, District, or Place.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "categoryId": { "type": "string", "enum": ["State", "District", "Place"] },
        "parent": { "type": "string" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "version": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "tagIds": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string", "format": "uri" }
      },
      "required": ["id", "title", "slug", "content", "authorId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Extended user data for registered archivists.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "username": { "type": "string" },
        "memberSince": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "themePreference": { "type": "string" },
        "preferredLanguageId": { "type": "string" }
      },
      "required": ["id", "email", "username"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/articles_published/{articleId}": {
      "schema": "#/backend/entities/Article",
      "description": "Primary flat collection for all heritage nodes."
    },
    "/articles_published/{articleId}/comments/{commentId}": {
      "schema": "object",
      "description": "Talk page community comments for historical nodes."
    },
    "/articles_published/{articleId}/revisions/{revisionId}": {
      "schema": "object",
      "description": "Historical snapshots of the heritage node contents."
    },
    "/user_profiles/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profiles and heritage preferences."
    },
    "/user_media_assets/{userId}/{assetId}": {
      "schema": "object",
      "description": "References to uploaded heritage media assets."
    }
  }
}
