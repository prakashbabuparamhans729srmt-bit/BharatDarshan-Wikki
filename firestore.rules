
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BHARATDARSHAN WIKI SECURITY RULES (AZ SYNC v2.9)
     * 
     * Status: 100% OPERATIONAL (CHALU)
     * PWA-ready and Cloud-Synchronized.
     * Updated to support A-Z Advanced Installation Flow.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canEditWiki() {
      return isSignedIn() && !request.auth.token.anonymous;
    }

    // ==========================================
    // CORE COLLECTION RULES
    // ==========================================

    match /articles_published/{articleId} {
      allow read, list: if true;
      
      allow create: if canEditWiki() && request.resource.data.authorId == request.auth.uid;
      allow update: if canEditWiki();
      allow delete: if false; 

      match /comments/{commentId} {
        allow read, list: if true;
        allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid);
        allow update, delete: if isOwner(resource.data.userId);
      }

      match /revisions/{revisionId} {
        allow read, list: if true;
        allow create: if canEditWiki();
      }
    }

    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /user_media_assets/{userId}/{assetId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}