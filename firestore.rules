
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BHARATDARSHAN WIKI - MASTER SECURITY RULES
     * STATUS: A-Z Advanced Flow 100% Operational
     * SYNC: 2024-Heritage-Crawl-Active
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- USER PROFILES ---
    match /user_profiles/{userId} {
      allow get: if true;
      allow list: if isSignedIn(); 
      allow create, update: if isOwner(userId);
      allow delete: if false; 
    }

    // --- CORE WIKI ARCHIVES ---
    match /articles_published/{articleId} {
      // Allow global reading (get and list) for A to Z discovery
      allow read: if true;
      
      // Contributions require verified authentication
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn(); // Allow community editing (Wiki style)
      allow delete: if false; 

      // Talk Page (Comments)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow delete: if isOwner(resource.data.userId);
      }

      // Revision History
      match /revisions/{revisionId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false; 
      }
    }

    // --- MEDIA ASSETS ---
    match /user_media_assets/{userId}/{assetId} {
      allow read: if true;
      allow create, delete: if isOwner(userId);
    }
    
    // --- GLOBAL INDEXES ---
    match /{path=**}/articles_published/{articleId} {
      allow read: if true;
    }
  }
}
