rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BHARATDARSHAN WIKI - SECURITY RULES DOCUMENTATION
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a robust, multi-layered authorization model designed for a public wiki 
     * ecosystem. It leverages Structural Segregation to separate public content from private drafts 
     * and relies on Path-Based Ownership for high-performance authorization.
     *
     * DATA STRUCTURE:
     * - /user_profiles/{userId}: Private profile management.
     * - /user_articles_drafts/{userId}/{articleId}: Private, owner-only draft space.
     * - /articles_published/{articleId}: Publicly accessible knowledge base.
     * - /roles_admin/{uid}: Administrative access control.
     * - Global Metadata (/categories, /tags, /languages): Publicly readable, admin-writable.
     *
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: Rules avoid costly cross-document lookups (get() calls) by 
     *    embedding ownership IDs directly into document paths or denormalizing them onto documents.
     * 2. QAP (Query as a Security Policy): Public and private articles are stored in separate 
     *    top-level collections. This ensures that a simple collection query automatically 
     *    respects security boundaries without complex server-side filtering.
     * 3. Prototyping Flexibility: While authorization (WHO can access) is strictly enforced, 
     *    the data shape (WHAT is inside) remains flexible to allow for rapid iterative development.
     * 4. Admin Override: A dedicated admin collection allows for global moderation and 
     *    metadata management.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user owns the existing document for updates/deletes. */
    function isExistingOwner(ownerIdField) {
      return resource != null && isOwner(ownerIdField);
    }

    /** @description Checks if the authenticated user has administrative privileges. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for user profiles. Users manage their own profiles; others can view them.
     * @path /user_profiles/{userId}
     * @allow (get) Any signed-in user. (update) Authenticated user where UID matches document ID.
     * @deny (list) Prevent bulk scraping of user data.
     * @principle Path-based ownership and relational integrity.
     */
    match /user_profiles/{userId} {
      allow get: if isSignedIn();
      // The `list` operation is designed for collections, not individual documents.
      // To prevent bulk scraping of user data, the `list` operation should be explicitly denied
      // at the collection level, or implicitly denied by not having a collection-level list rule.
      // Allowing `list` on a document path is semantically incorrect and doesn't achieve the "deny (list)" goal.
      // Therefore, the specific `allow list` rule for documents is removed for clarity and correctness.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isAdmin();
    }

    /**
     * @description Global metadata for content organization.
     * @path /categories/{categoryId}, /tags/{tagId}, /languages/{languageId}
     * @allow (read) Public access for all users. (write) Admin users only.
     * @deny (write) Any non-admin user.
     * @principle Global roles (DBAC) for system-wide configuration.
     */
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /languages/{languageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /**
     * @description Publicly published articles.
     * @path /articles_published/{articleId}
     * @allow (read) Public access. (create/update) The author of the article.
     * @deny (delete) Standard users; deletion reserved for admins.
     * @principle Ownership-based writes with public read access.
     */
    match /articles_published/{articleId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isAdmin();

      /**
       * @description User comments on published articles.
       * @path /articles_published/{articleId}/comments/{commentId}
       * @allow (read) Public. (create) Any signed-in user. (update/delete) Comment author.
       * @principle Relational integrity and owner-managed interactions.
       */
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.userId);
        allow delete: if isExistingOwner(resource.data.userId) || isAdmin();
      }

      /**
       * @description Historical revisions of an article.
       * @path /articles_published/{articleId}/revisions/{revisionId}
       * @allow (read) Public. (create) Any contributor (signed-in user).
       * @principle Immutable history tracking.
       */
      match /revisions/{revisionId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      /**
       * @description Multi-language translations for published articles.
       * @path /articles_published/{articleId}/translations/{languageId}
       * @allow (read) Public. (write) Authenticated users contributing translations.
       * @principle Collaborative contribution model.
       */
      match /translations/{languageId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    /**
     * @description Private article drafts. Only the owner can see or edit.
     * @path /user_articles_drafts/{userId}/{articleId}
     * @allow (all) Authenticated user where UID matches the path.
     * @deny (all) Any user other than the owner.
     * @principle Structural segregation for private workspace.
     */
    match /user_articles_drafts/{userId}/{articleId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description User-uploaded media assets. Metadata is private; URLs may be used publicly.
     * @path /user_media_assets/{userId}/{mediaAssetId}
     * @allow (all) Authenticated user where UID matches the path.
     * @deny (read) Non-owners (metadata only).
     * @principle Path-based ownership for asset management.
     */
    match /user_media_assets/{userId}/{mediaAssetId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Administrative roles.
     * @path /roles_admin/{uid}
     * @allow (get) Signed-in users checking their own status.
     * @deny (write/list) All users; managed via Admin SDK/Console only.
     * @principle Restricted administrative hierarchy.
     */
    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }
  }
}