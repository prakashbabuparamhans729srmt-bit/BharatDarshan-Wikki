rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BHARATDARSHAN WIKI - SECURITY RULES CONFIGURATION
     * 
     * Core Philosophy:
     * This ruleset enforces a "Contributor Ownership" model combined with "Public Consumption" for published 
     * content. 
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- COLLECTION RULES ---

    /**
     * @path /user_profiles/{userId}
     */
    match /user_profiles/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @path /roles_admin/{userId}
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    /**
     * Master geographical and thematic data.
     */
    match /states/{stateId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /districts/{districtId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /places/{placeId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /languages/{languageId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @path /user_media_assets/{userId}/{assetId}
     */
    match /user_media_assets/{userId}/{assetId} {
      allow get, list: if true;
      allow create, update, delete: if isOwner(userId);
    }

    /**
     * @path /articles_published/{articleId}
     */
    match /articles_published/{articleId} {
      allow get, list: if true; 
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.authorId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.authorId) || isAdmin();

      /**
       * Subcollections for Revisions, Comments, and Translations
       */
      match /revisions/{revisionId} {
        allow get, list: if true; 
        allow create: if isSignedIn();
        allow update, delete: if isExistingOwner(resource.data.userId) || isAdmin();
      }

      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update, delete: if isExistingOwner(resource.data.userId) || isAdmin();
      }

      match /translations/{translationId} {
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      match /aiSuggestions/{aiSuggestionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }
  }
}