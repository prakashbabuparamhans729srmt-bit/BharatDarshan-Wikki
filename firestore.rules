rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BHARATDARSHAN WIKI SECURITY RULES (ADVANCED SYNC)
     * 
     * Core Philosophy:
     * 1. Public Reading: Heritage discovery is for everyone.
     * 2. Authenticated Contribution: Only signed-in members can edit history.
     * 3. Owner Protection: Profiles and media belong to the user.
     */

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admins/$(request.auth.uid));
    }

    function canEditWiki() {
      // Allows logged-in users who aren't anonymous, or specific admin override.
      return isSignedIn() && (!request.auth.token.anonymous || isAdmin());
    }

    // ==========================================
    // CORE COLLECTION RULES
    // ==========================================

    /**
     * @description Heritage Articles Node
     * Access: Everyone can browse (read/list). Members can contribute.
     */
    match /articles_published/{articleId} {
      allow read, list: if true;
      allow create: if canEditWiki() && request.resource.data.authorId == request.auth.uid;
      allow update: if canEditWiki();
      allow delete: if isAdmin();

      // Subcollection: Talk Page (Community Discussion)
      match /comments/{commentId} {
        allow read, list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // Subcollection: Revision History (Time-stamped Logs)
      match /revisions/{revisionId} {
        allow read, list: if true;
        allow create: if canEditWiki();
      }
    }

    /**
     * @description Archivist Profiles
     */
    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Visual Heritage Assets
     */
    match /user_media_assets/{userId}/{assetId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Recursive match for media subpaths
    match /user_media_assets/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    /**
     * @description System Access Control
     */
    match /roles_admins/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // LEGACY & SYNC FALLBACKS
    // ==========================================
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }
  }
}