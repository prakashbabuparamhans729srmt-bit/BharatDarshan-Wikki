
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utility functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User Profiles
    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Heritage Articles (Wiki Nodes)
    match /articles_published/{articleId} {
      // Global read access for encyclopedia browsing
      allow read: if true;
      
      // Contribution and Editing
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false; 

      // Talk Page (Comments)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow delete: if isOwner(resource.data.userId);
      }

      // Revision History
      match /revisions/{revisionId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false; 
      }
    }

    // Media Assets
    match /user_media_assets/{userId}/{assetId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    // Global list access helper
    match /{path=**}/articles_published/{articleId} {
      allow read: if true;
    }
  }
}
