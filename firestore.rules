rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * BHARATDARSHAN WIKI SECURITY RULES (ADVANCED SYNC)
     * 
     * Core Philosophy:
     * Public reading for heritage discovery.
     * Authenticated/Role-based writes for contribution.
     * Owner-based writes for profiles and media.
     */

    // ==========================================
    // GLOBAL HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admins/$(request.auth.uid));
    }

    function isContributor() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_contributors/$(request.auth.uid));
    }

    function canEditWiki() {
      // In guest-friendly mode for prototype, we allow signed-in users 
      // who aren't anonymous to contribute, or specific role check.
      return isSignedIn() && (!request.auth.token.anonymous || isAdmin() || isContributor());
    }

    // ==========================================
    // COLLECTION RULES
    // ==========================================

    /**
     * @description Primary Heritage Archive Node
     * Used by: Home, Browse, Search, Article pages.
     */
    match /articles_published/{articleId} {
      allow read: if true;
      allow create: if canEditWiki() && request.resource.data.authorId == request.auth.uid;
      allow update: if canEditWiki();
      allow delete: if isAdmin();

      // Nested Talk Page (Comments)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // Nested Version History
      match /revisions/{revisionId} {
        allow read: if true;
        allow create: if canEditWiki() && request.resource.data.userId == request.auth.uid;
      }
    }

    /**
     * @description User Profile Node
     * Synchronizes user data for the dashboard and settings.
     */
    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    /**
     * @description User Media Archive
     * Stores pointers to heritage images and videos.
     */
    match /user_media_assets/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
      
      match /{allSubpaths=**} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    /**
     * @description System Roles Node
     */
    match /roles_admins/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /roles_contributors/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Legacy State/District/POI paths from backend.json (Keeping for safety)
    match /states/{stateId} {
      allow read: if true;
      allow write: if canEditWiki();
      match /districts/{districtId} {
        allow read: if true;
        allow write: if canEditWiki();
        match /pointsOfInterest/{poiId} {
          allow read: if true;
          allow write: if canEditWiki();
        }
      }
    }
  }
}